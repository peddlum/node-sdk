{
  "name": "@peddlum/node-sdk",
  "version": "0.1.2",
  "description": "Official Node.js SDK for Peddlum — auth, data, storage, chatbot, payments, push, email, AI, and more. Works in Node 18+ and Cloudflare Workers (with nodejs_compat).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser/browser/index.d.ts",
      "import": "./dist/browser/browser/index.js",
      "require": "./dist/browser/browser/index.js"
    },
    "./browser/bundle": {
      "types": "./dist/browser/browser/index.d.ts",
      "import": "./dist/browser/peddlum-chatbot.mjs"
    }
  },
  "scripts": {
    "build": "npm run build:node && npm run build:browser && npm run build:bundle",
    "build:node": "tsc",
    "build:browser": "tsc --project tsconfig.browser.json",
    "build:bundle": "esbuild src/browser/index.ts --bundle --format=esm --platform=browser --target=es2019 --outfile=dist/browser/peddlum-chatbot.mjs",
    "dev": "tsc --watch",
    "test": "jest --passWithNoTests",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "peddlum",
    "baas",
    "auth",
    "database",
    "storage",
    "payments",
    "chatbot",
    "push-notifications",
    "multi-tenant",
    "api-sdk"
  ],
  "author": "Peddlum",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/peddlum/node-sdk.git"
  },
  "homepage": "https://github.com/peddlum/node-sdk",
  "bugs": {
    "url": "https://github.com/peddlum/node-sdk/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.0",
    "form-data": "^4.0.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.12.0",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  }
}
